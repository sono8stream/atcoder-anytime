{
  "name": "functions",
  "scripts": {
    "lint": "node node_modules/tslint/bin/tslint --project tsconfig.json",
    "build": "node node_modules/typescript/bin/tsc --build --force && printf '#!/usr/bin/env node\\nrequire(\"../firebase-functions/lib/bin/firebase-functions.js\");\\n' > node_modules/.bin/firebase-functions",
    "serve": "tsc-watch --build --onFirstSuccess \"firebase serve --only functions\"",
    "shell": "tsc-watch --build --onFirstSuccess \"firebase functions:shell\"",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^0.21.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.9.0"
  },
  "devDependencies": {
    "tsc-watch": "^4.2.9",
    "tslint": "^6.1.2",
    "typescript": "^5.4.0"
  },
  "private": true,
  "engines": {
    "node": "20"
  }
}
